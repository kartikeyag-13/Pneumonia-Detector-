# PostgreSQL connection details.
# On Render, point these at your Supabase Postgres database.
# NOTE: if your password contains URL special characters (@, /, :, %, #),
# URL-encode them (e.g. %40 for @) or the connection will fail.
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=

# JWT settings. Generate a strong random secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Supabase Storage (private bucket). The service-role key is used only
# server-side and must never be shared with clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pneumonia-images

# Image upload limits (optional overrides)
# MAX_UPLOAD_SIZE_BYTES=10485760

# ML model path (relative to project root)
MODEL_PATH=model/pneumonia_detection_model.pth

# Backend base URL (used by the frontend to reach the API)
BASE_URL=http://localhost:8000
